# Copiar como .env y ajustar
# MongoDB local (docker compose up mongodb) o MongoDB Atlas:
#   mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/alertabarrio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/alertabarrio
JWT_SECRET=cambiar-por-un-secreto-largo
TEAM_MEMBERS=Integrante 1,Integrante 2
CORS_ORIGINS=*
SEED_ON_STARTUP=true
TIMEZONE=America/Bogota
VERIFICATIONS_REQUIRED=2
# Ciudad que muestra la app
CITY=Pasto
# Clave de las cuentas de prueba del seed y de la cuenta del profesor
DEMO_PASSWORD=Alerta2026*
# PROFESOR_PASSWORD=
