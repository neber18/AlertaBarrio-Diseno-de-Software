@startuml Vista_Desarrollo_AlertaBarrio
title Vista de Desarrollo - Organización del código de AlertaBarrio (monorepo)
skinparam packageStyle rectangle

package "Cliente (fuera del repositorio)" {
  class ClienteHTTP <<Swagger UI / Postman / curl>>
}

package "backend/ (FastAPI + PyMongo)" {
  package "Capa de presentación (API)" {
    class Aplicacion <<main.py>> {
      aplicación FastAPI, CORS, cabeceras
    }
    class Controladores <<routers/>> {
      auth, reports, moderation
      notifications, routes
      catalog, general
    }
    class Esquemas <<schemas.py>> {
      modelos de entrada/salida
    }
    class Serializadores <<serializers.py>>
  }
  package "Capa de negocio" {
    class Seguridad <<security.py>> {
      bcrypt, JWT, TOTP
      bloqueo por intentos, límite de solicitudes
    }
    class Servicios <<services/>> {
      engine (MotorAlertas)
      report_service, geo
    }
    class EstructurasDeDatos <<structures/>> {
      dynamic_array, linked_list
      stack, queue, priority_queue
      hash_table, bst (AVL)
      graph, sorting
    }
  }
  package "Capa de persistencia" {
    class Modelos <<models.py>> {
      Document / Embedded
    }
    class AccesoDatos <<database.py>> {
      cliente MongoDB
      counters, índices
    }
    class DatosIniciales <<seed.py>> {
      barrios_pasto.py
      datos de ejemplo
    }
  }
  class Configuracion <<config.py>> {
    variables de entorno
  }
  class PruebasBackend <<tests/>> {
    test_api, test_structures
  }
}

package "Infraestructura" {
  class Contenedores <<docker-compose.yml>> {
    mongodb, mongo-express
    backend
  }
  class ImagenesDocker <<Dockerfile>>
  class FlujosCI <<.github/workflows>> {
    ci.yml, keep-alive.yml
  }
  class DespliegueRender <<render.yaml>>
  class ScriptArranque <<run.sh>>
}

package "docs/" {
  class Wiki <<wiki/>>
  class HistoriasUsuario <<issues/ HU_001..HU_021>>
  class Diagramas <<diagramas/>>
}

package "Base de datos" {
  class BaseMongo <<MongoDB 7 / Atlas>> {
    users, neighborhoods, incident_types
    reports, subscriptions
    notifications, counters
  }
}

ClienteHTTP ..> Aplicacion : HTTP/JSON
Aplicacion ..> Controladores
Aplicacion ..> Configuracion
Controladores ..> Esquemas
Controladores ..> Serializadores
Controladores ..> Seguridad
Controladores ..> Servicios
Servicios ..> EstructurasDeDatos
Servicios ..> Modelos
Seguridad ..> Modelos
Modelos ..> AccesoDatos
DatosIniciales ..> Modelos
AccesoDatos ..> BaseMongo : PyMongo / TCP 27017
PruebasBackend ..> Controladores
Contenedores ..> ImagenesDocker
FlujosCI ..> PruebasBackend
@enduml
