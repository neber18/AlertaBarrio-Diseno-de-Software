@startuml Vista_Logica_AlertaBarrio
title Vista Lógica (Diagrama de Clases) - AlertaBarrio (MongoDB)
skinparam classAttributeIconSize 0

class Usuario <<document>> {
  +id : int
  +nombreCompleto : String
  +email : String {unique}
  +passwordHash : String
  +telefono : String
  +rol : Rol
  +activo : boolean
  +totpActivo : boolean
  +iniciarSesion()
  +cambiarPassword()
  +activar2FA()
}
enum Rol {
  CITIZEN
  MODERATOR
  ADMIN
}
class Barrio <<document>> {
  +id : int
  +nombre : String {unique}
  +ciudad : String
  +comuna : int
  +latitud : double
  +longitud : double
}
class Via <<embedded>> {
  +barrioDestinoId : int
  +distanciaMetros : double
  +nombreVia : String
}
class TipoIncidente <<document>> {
  +id : int
  +codigo : String {unique}
  +nombre : String
  +gravedad : int
  +color : String
}
class Reporte <<document>> {
  +id : int
  +titulo : String
  +descripcion : String
  +latitud : double
  +longitud : double
  +direccion : String
  +fechaOcurrencia : DateTime
  +estado : EstadoReporte
  +prioridad : double
  +confianzaIA : double
  +riesgoZonaIA : double
  +nombreVecino : String
  +cambiarEstado()
  +deshacer()
  +verificar()
}
enum EstadoReporte {
  CREATED
  IN_REVIEW
  PUBLISHED
  VERIFIED
  REJECTED
}
class FotoReporte <<embedded>> {
  +url : String
  +fecha : DateTime
}
class CambioEstado <<embedded>> {
  +id : int
  +estadoAnterior : String
  +estadoNuevo : String
  +nota : String
  +fecha : DateTime
}
class Verificacion <<embedded>> {
  +usuarioId : int
  +confirmado : boolean
  +comentario : String
}
class Suscripcion <<document>> {
  +fecha : DateTime
}
class Notificacion <<document>> {
  +mensaje : String
  +leida : boolean
  +fecha : DateTime
  +marcarLeida()
}
class AnalisisIA <<document>> {
  +tipo : String
  +modelo : String
  +latenciaMs : int
  +resultado : JSON
}
class ResumenDiario <<document>> {
  +fecha : String
  +texto : String
  +cantidadReportes : int
}
class ZonaRiesgo <<document>> {
  +diaSemana : int
  +franjaHoraria : int
  +riesgo : double
}

Usuario --> Rol
Usuario "*" --> "0..1" Barrio : vive en
Usuario "1" -- "*" Reporte : crea >
Reporte "*" --> "1" Barrio : ocurre en
Reporte "*" --> "1" TipoIncidente : tipo
Reporte "*" --> "0..1" TipoIncidente : sugerido por IA
Reporte --> EstadoReporte
Reporte "1" *-- "*" FotoReporte : embebido
Reporte "1" *-- "1..*" CambioEstado : embebido (pila)
Reporte "1" *-- "*" Verificacion : embebido
Verificacion "*" --> "1" Usuario : vecino
Barrio "1" *-- "*" Via : embebido
Via "*" --> "1" Barrio : destino
Usuario "1" -- "*" Suscripcion
Suscripcion "*" --> "1" Barrio
Notificacion "*" --> "1" Usuario
Notificacion "*" --> "0..1" Reporte
ResumenDiario "*" --> "1" Barrio
ZonaRiesgo "*" --> "1" Barrio
AnalisisIA "*" --> "0..1" Reporte
@enduml
