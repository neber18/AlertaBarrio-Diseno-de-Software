@startuml Vista_Logica_AlertaBarrio
title Vista Lógica (Diagrama de Clases) - AlertaBarrio: dominio en MongoDB + motor de alertas
skinparam classAttributeIconSize 0

class Usuario <<document>> {
  +id : int
  +nombreCompleto : String
  +email : String {unique}
  +passwordHash : String
  +telefono : String
  +rol : Rol
  +activo : boolean
  +totpActivo : boolean
  +tokenVersion : int
  +fechaCreacion : DateTime
  +ultimoIngreso : DateTime
  +{static} buscarPorCorreo(bd, correo) : Usuario
}
enum Rol {
  VECINO
  MODERADOR
  ADMINISTRADOR
}
class Barrio <<document>> {
  +id : int
  +nombre : String {unique}
  +ciudad : String
  +comuna : int
  +latitud : double
  +longitud : double
  +fechaCreacion : DateTime
}
class Via <<embedded>> {
  +barrioDestinoId : int
  +distanciaMetros : double
  +nombreVia : String
}
class TipoIncidente <<document>> {
  +id : int
  +codigo : String {unique}
  +nombre : String
  +gravedad : int
  +color : String
}
class Reporte <<document>> {
  +id : int
  +titulo : String
  +descripcion : String
  +latitud : double
  +longitud : double
  +direccion : String
  +fechaOcurrencia : DateTime
  +estado : EstadoReporte
  +prioridad : double
  +nombreVecino : String
  +fechaCreacion : DateTime
  +fechaActualizacion : DateTime
  +confirmaciones() : int
  +guardar(bd)
}
enum EstadoReporte {
  CREADO
  EN_REVISION
  PUBLICADO
  VERIFICADO
  RECHAZADO
}
class FotoReporte <<embedded>> {
  +url : String
  +fecha : DateTime
}
class CambioEstado <<embedded>> {
  +id : int
  +estadoAnterior : String
  +estadoNuevo : String
  +cambiadoPor : int
  +nota : String
  +fecha : DateTime
}
class Verificacion <<embedded>> {
  +usuarioId : int
  +confirmado : boolean
  +comentario : String
  +fecha : DateTime
}
class Suscripcion <<document>> {
  +fecha : DateTime
}
class Notificacion <<document>> {
  +mensaje : String
  +leida : boolean
  +fecha : DateTime
}

Usuario --> Rol
Usuario "*" --> "0..1" Barrio : vive en
Usuario "1" -- "*" Reporte : crea >
Reporte "*" --> "1" Barrio : ocurre en
Reporte "*" --> "1" TipoIncidente : tipo
Reporte --> EstadoReporte
Reporte "1" *-- "*" FotoReporte : embebido
Reporte "1" *-- "1..*" CambioEstado : embebido (pila)
Reporte "1" *-- "*" Verificacion : embebido
Verificacion "*" --> "1" Usuario : vecino
Barrio "1" *-- "*" Via : embebido
Via "*" --> "1" Barrio : destino
Usuario "1" -- "*" Suscripcion
Suscripcion "*" --> "1" Barrio
Notificacion "*" --> "1" Usuario : destinatario
Notificacion "*" --> "0..1" Reporte : sobre

note bottom of Barrio
  counters (colección aparte): guarda el último
  id usado por cada colección; next_id() lo sube
  con $inc atómico para que los ids sean enteros.
end note

' ===== Servicios (módulos de funciones en el código)
class ServicioReportes <<módulo report_service.py>> {
  +crearReporte(bd, usuario, datos) : ReporteCreado
  +cambiarEstado(bd, reporte, nuevoEstado, usuario, nota) : CambioEstado
  +publicar(bd, reporte, moderador, nota) : int
  +deshacer(bd, reporte) : (deshecho, actual)
  +despacharNotificaciones(bd) : int
  +obtenerReporteO404(bd, id) : Reporte
}
class ReporteCreado {
  +reporte : Reporte
  +posicionEnCola : int
}
class Seguridad <<módulo security.py>> {
  -bloqueoLogin : LoginThrottle
  -limiteAuth : RateLimiter
  +hashPassword(clave) : String
  +verificarPassword(clave, hash) : boolean
  +validarFortaleza(clave)
  +crearToken(usuario) : JWT
  +usuarioActual(token) : Usuario
  +requerirModerador(usuario) : Usuario
  +nuevoSecretoTOTP() : String
  +verificarTOTP(secreto, codigo) : boolean
}
class LoginThrottle <<bloqueo por intentos>> {
  +segundosBloqueado(correo) : int
  +fallo(correo)
  +reiniciar(correo)
}
class RateLimiter <<límite de solicitudes>> {
  +registrar(clave, limite, ventana) : int
}

ServicioReportes ..> Reporte : crea y modifica
ServicioReportes ..> CambioEstado : agrega al historial
ServicioReportes ..> Notificacion : guarda
ServicioReportes ..> ReporteCreado : devuelve
ServicioReportes ..> MotorAlertas : usa
Seguridad ..> Usuario : autentica
Seguridad *-- LoginThrottle
Seguridad *-- RateLimiter

' ===== Motor de alertas en memoria (estructuras de datos propias)
class MotorAlertas {
  -colaModeracion : ColaPrioridad<ElementoReporte>
  -pilasEstado : TablaHash<int, Pila<EntradaEstado>>
  -feedsPorBarrio : TablaHash<int, ListaEnlazada<ElementoReporte>>
  -suscritosPorBarrio : TablaHash<int, ListaEnlazada<int>>
  -colaNotificaciones : Cola<NotificacionPendiente>
  -lineaTiempo : ArbolAVL<double, int>
  -grafoCiudad : Grafo
  -catalogoBarrios : ArregloDinamico
  -elementos : TablaHash<int, ElementoReporte>
  -candado : RLock
  -despachadasTotal : int
  +cargar(bd)
  +agregarReporte(elemento, primerEstado) : int
  +obtenerElemento(reporteId) : ElementoReporte
  +ordenCola() : List<ElementoReporte>
  +tomarSiguiente() : ElementoReporte
  +tomarEspecifico(reporteId) : ElementoReporte
  +reencolar(reporteId)
  +apilarEstado(reporteId, cambio)
  +desapilarEstado(reporteId) : (deshecho, actual)
  +pilaEstado(reporteId) : List<EntradaEstado>
  +publicar(reporteId, autorId, mensaje) : int
  +despublicar(reporteId, mensaje)
  +idsDelFeed(barrioId, limite) : List<int>
  +idsEnRango(inicio, fin) : List<int>
  +conteoPorZona() : Dict<int, int>
  +severidadPorZona() : Dict<int, int>
  +ranking() : List
  +suscribir(barrioId, usuarioId)
  +desuscribir(barrioId, usuarioId)
  +cantidadSuscriptores(barrioId) : int
  +vaciarNotificaciones(maximo) : List
  +buscarBarrio(nombre) : int
  +estadoInterno() : dict
}
class ElementoReporte {
  +id : int
  +titulo : String
  +barrioId : int
  +usuarioId : int
  +gravedad : int
  +prioridad : double
  +estado : String
  +fechaCreacion : DateTime
}
class EntradaEstado {
  +cambioId : int
  +estadoAnterior : String
  +estadoNuevo : String
  +cambiadoPor : int
  +fecha : DateTime
  +nota : String
}
class NotificacionPendiente {
  +usuarioId : int
  +reporteId : int
  +mensaje : String
  +fechaEncolada : DateTime
}
class ColaPrioridad<T> <<max-heap>> {
  +insertar(elemento)
  +extraerMax() : T
  +verMax() : T
  +eliminar(id) : T
  +enOrden() : List
}
class Pila<T> {
  +apilar(elemento)
  +desapilar() : T
  +cima() : T
}
class Cola<T> <<buffer circular>> {
  +encolar(elemento)
  +desencolar() : T
  +frente() : T
}
class ListaEnlazada<T> <<doble>> {
  +insertarAlInicio(elemento)
  +insertarAlFinal(elemento)
  +eliminarPrimero(condicion)
  +insertarOrdenado(elemento, clave)
}
class TablaHash<K,V> <<encadenamiento>> {
  +poner(clave, valor)
  +obtener(clave) : V
  +eliminar(clave) : V
  +factorCarga() : double
}
class ArbolAVL<K,V> <<árbol binario de búsqueda>> {
  +insertar(clave, valor)
  +buscar(clave) : List
  +consultarRango(desde, hasta) : List
  +altura() : int
}
class Grafo {
  +agregarVertice(v)
  +agregarArista(u, v, peso)
  +dijkstra(origen, destino)
  +caminoBFS(origen, destino)
  +alcanzablesDFS(origen)
}
class ArregloDinamico<T> {
  +agregar(elemento)
  +obtener(i) : T
  +insertar(i, elemento)
  +eliminarEn(i) : T
}
class Ordenamiento <<utilidad>> {
  +mergeSort(lista, clave)
  +quickSort(lista, clave)
  +busquedaBinaria(lista, valor)
}

note right of MotorAlertas
  Nombre en el código (backend/app):
  MotorAlertas = AlertEngine
  ElementoReporte = ReportItem
  ServicioReportes = report_service.py
  Seguridad = security.py
  EntradaEstado = StatusEntry
  NotificacionPendiente = PendingNotification
  ColaPrioridad = PriorityQueue
  Pila = Stack, Cola = Queue
  ListaEnlazada = LinkedList
  TablaHash = HashTable
  ArbolAVL = BinarySearchTree
  Grafo = Graph
  ArregloDinamico = DynamicArray
  Ordenamiento = sorting.py
  Valores guardados en MongoDB:
  Rol = citizen, moderator, admin
  EstadoReporte = created, in_review,
  published, verified, rejected
end note

MotorAlertas *-- "1" ColaPrioridad : cola de moderación
MotorAlertas *-- "*" Pila : historial por reporte
MotorAlertas *-- "*" ListaEnlazada : feed por barrio / suscritos
MotorAlertas *-- "1..*" TablaHash : índices
MotorAlertas *-- "1" Cola : notificaciones FIFO
MotorAlertas *-- "1" ArbolAVL : línea de tiempo
MotorAlertas *-- "1" Grafo : barrios y vías
MotorAlertas *-- "1" ArregloDinamico : catálogo de barrios
MotorAlertas ..> Ordenamiento : usa
ColaPrioridad o-- "*" ElementoReporte
ListaEnlazada o-- "*" ElementoReporte
Pila o-- "*" EntradaEstado
Cola o-- "*" NotificacionPendiente

' ===== Cómo se conectan las dos partes
ElementoReporte ..> Reporte : se crea desde
EntradaEstado ..> CambioEstado : se crea desde
NotificacionPendiente ..> Notificacion : se guarda como
@enduml
