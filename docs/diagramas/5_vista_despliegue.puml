@startuml Vista_Despliegue_AlertaBarrio
title Vista de Despliegue - AlertaBarrio

node "PC / celular del usuario" as N1 {
  artifact "Cliente HTTP\n(Swagger UI, Postman, curl)" as A1
}
node "Render - servicio web\n<<Docker, Python 3.11>>" as N3 {
  artifact "alertabarrio-backend\n(FastAPI + uvicorn)" as A3
}
node "Render - servicio web\n<<Docker, Python 3.11>>" as N4 {
  artifact "alertabarrio-ai\n(FastAPI)" as A4
}
node "MongoDB Atlas - clúster M0 (AWS)\n<<MongoDB 7>>" as N5 {
  database "colecciones del sistema" as A5
}

N1 --> N3 : HTTPS / JSON (API REST)
N3 --> N4 : HTTPS / JSON
N3 --> N5 : MongoDB / TCP 27017 (TLS)
@enduml
